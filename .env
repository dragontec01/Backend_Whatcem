# Configuración del Servidor
NODE_ENV=development
PORT=3000

# Base de Datos (Si usas Compass local, usa localhost)
MONGODB_URI=mongodb://localhost:27017/dtchcxdb

# Autenticación (Ambas deben ser iguales para evitar errores)
JWT_SECRET=cxdtec-secret-2026-local
SECRET_JWT_SEED=cxdtec-secret-2026-local
JWT_EXPIRES_IN=2h

# Email (Configuración para Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
#usar una cuenta de correo correspondiente al dominio de la aplicación y generar una contraseña de aplicación de 16 caracteres para mayor seguridad
#De momento para probar si funciona, podnré una cuenta de correo personal, pero se recomienda usar una cuenta de correo profesional para evitar problemas de seguridad y reputación del dominio.

EMAIL_USER=*
EMAIL_PASS=*

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=*